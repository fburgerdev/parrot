[[snippet "surface"]]
// light
const uint MAX_LIGHT_COUNT = uint(50); 
// :: ambient
struct AmbientLight {
  float intensity;
  vec3 color;
};
// :: directional
struct DirectionalLight {
  vec3 direction;
  float intensity;
  vec3 color;
};

// std
layout (std140) uniform u_std {
  // camera
  vec3 u_camera_pos;

  // world_to_clip
  mat4 u_world_to_clip;

  // light
  // :: ambient
  uint u_ambient_count;
  AmbientLight u_ambient_lights[MAX_LIGHT_COUNT];
  // :: directional
  uint u_directional_count;
  DirectionalLight u_directional_lights[MAX_LIGHT_COUNT];
};

// surface
struct Surface {
  // ambient
  float ambient_strength;
  // diffuse
  float diffuse_strength;
  // specular
  float shininess;
  float specular_strength;
};
uniform Surface u_surface = Surface(1, 1, 1, 1);

// applyLighting
vec3 applyLighting(vec3 in_color, vec3 position, vec3 normal) {
  vec3 out_color = vec3(0);
  // ambient
  for (uint i = uint(0); i < u_ambient_count; ++i) {
    // ambient
    vec3 ambient = u_ambient_lights[i].intensity * u_ambient_lights[i].color;
    out_color += (ambient * u_surface.ambient_strength) * in_color;
  }
  // directional
  for (uint i = uint(0); i < u_directional_count; ++i) {
    // diffuse
    float diffuse = clamp(dot(
      -u_directional_lights[i].direction, normal
    ), 0, 1);
    // specular
    vec3 view_direction = normalize(position - u_camera_pos);
    float compensation = (u_surface.shininess + 2.0) / 8.0;
    vec3 reflect_direction = reflect(u_directional_lights[i].direction, normal);
    float specular_factor = max(dot(-view_direction, reflect_direction), 0.0);
    float specular = pow(specular_factor, u_surface.shininess) * compensation;
    // total
    float total = 0;
    total += diffuse * u_surface.diffuse_strength;
    total += specular * u_surface.specular_strength;
    vec3 color = (
      u_directional_lights[i].intensity * u_directional_lights[i].color
    );
    out_color += total * color * in_color;
  }
  return out_color;
}

// texture + tint
// :: texture
uniform sampler2D u_albedo;
uniform sampler2D u_normal;
uniform sampler2D u_specular;
// :: tint
uniform vec3 u_tint = vec3(1, 1, 1);

// calcSurfaceColor
vec3 calcSurfaceColor(
  vec3 position, vec3 normal, vec2 tex_coords, vec3 tangent, vec3 bitangent
) {
  mat3 tbn = mat3(tangent, bitangent, normal);
  vec3 albedo = texture(u_albedo, tex_coords).rgb * u_tint;
  vec3 rough_normal = tbn * (texture(u_normal, tex_coords).rgb * 2 - vec3(1));
  return applyLighting(albedo, position, rough_normal);
}
[[end]]