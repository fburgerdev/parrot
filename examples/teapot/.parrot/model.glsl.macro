[[vertex(330 core)]]
// in
layout (location = 0) in vec3 a_position;
layout (location = 1) in vec3 a_normal;
layout (location = 2) in vec2 a_tex_coords;
layout (location = 3) in vec3 a_tangent;
// out
out vec3 v_position;
out vec3 v_normal;
out vec2 v_tex_coords;
out vec3 v_tangent;
out vec3 v_bitangent;

// general
uniform float u_total_time;

// world-to-clip
[[include "surface"]]

// model
uniform mat4 u_local_to_world;
uniform mat4 u_local_to_world_normal;

// (snippet) global
[[include "vertex-global" optional]]

// main
void main() {
    // (snippet) prefix
    [[include "vertex-prefix" optional]]
    
    // position
    gl_Position = u_world_to_clip * u_local_to_world * vec4(a_position, 1);

    // out
    v_position = (u_local_to_world * vec4(a_position, 1)).xyz;
    v_normal = (u_local_to_world_normal * vec4(a_normal, 0)).xyz;
    v_tex_coords = a_tex_coords;
    v_tangent = a_tangent;
    v_bitangent = cross(a_tangent, (u_local_to_world_normal * vec4(a_normal, 0)).xyz);

    // (snippet) postfix
    [[include "vertex-postfix" optional]]
}
[[end]]

[[fragment(330 core)]]
// in
in vec3 v_position;
in vec3 v_normal;
in vec2 v_tex_coords;
in vec3 v_tangent;
in vec3 v_bitangent;
// out
out vec4 o_frag_color; 

// general
uniform float u_total_time;

// camera + textures + lights
[[include "surface"]]

// (snippet) global
[[include "fragment-global" optional]]

// main
void main() {
    // (snippet) prefix
    [[include "fragment-prefix" optional]]

    // out
    o_frag_color = vec4(calcSurfaceColor(
      v_position, v_normal, v_tex_coords,
      v_tangent, v_bitangent
    ), 1);
    
    // (snippet) postfix
    [[include "fragment-postfix" optional]]
}
[[end]]