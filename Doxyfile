# Doxyfile Configuration

# Source Code
INPUT = ./src
FILE_PATTERNS = *.hh
RECURSIVE = YES
EXTRACT_PRIVATE = NO
EXTRACT_PROTECTED = NO
EXTRACT_UNDOCUMENTED = NO
HIDE_UNDOC_CLASSES = YES
HIDE_UNDOC_MEMBERS = YES
INLINE_SOURCES = NO
SOURCE_BROWSER = NO

# XML Output
GENERATE_XML = YES
XML_OUTPUT = xml
OUTPUT_DIRECTORY = build/doxygen
GENERATE_HTML = NO