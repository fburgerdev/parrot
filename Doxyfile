# Doxyfile Configuration

# Source Code
INPUT = ./src
FILE_PATTERNS = *.hh
RECURSIVE = YES
EXTRACT_ALL = NO
EXTRACT_PRIVATE = NO
EXTRACT_STATIC = YES
HIDE_UNDOC_CLASSES = YES
HIDE_UNDOC_MEMBERS = YES
HIDE_SCOPE_NAMES = YES
SHOW_INCLUDE_FILES = NO
SHOW_USED_FILES = NO
INLINE_SOURCES = NO
SOURCE_BROWSER = NO
ENABLE_PREPROCESSING = YES
MACRO_EXPANSION = YES
EXPAND_ONLY_PREDEF = NO
PREDEFINED += DOXYGEN

# XML Output
GENERATE_XML = YES
XML_OUTPUT = xml
OUTPUT_DIRECTORY = build/doxygen
GENERATE_HTML = NO